# Copy this file to .env in noobzy-studio/backend/ (or export these as real
# environment variables before starting uvicorn). Never commit a real .env.
# Every one of these is OPTIONAL: the app works end-to-end locally without
# any of them -- narration falls back to a local placeholder voice, and
# GPU/cloud features report "not configured" instead of failing silently.

# --- ElevenLabs (real narration) ---
# Required for real voice. Without these, narration uses the local
# placeholder tone synthesizer (clearly tagged is_placeholder_voice=true).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Optional LLM provider (scene understanding / script assistance) ---
# Not wired to a live call in this build; reserved for a future adapter.
LLM_API_KEY=

# --- Optional paid cloud GPU (RunPod) ---
# Required only for the gated runpod_gpu compute provider. No job is ever
# submitted without an explicit CostApproval(approved_by_user=True) and a
# max_spend_usd cap, regardless of whether this key is set.
RUNPOD_API_KEY=

# --- Optional local ComfyUI instance ---
# Required only for the gated comfyui_local compute provider (AI image/video
# workflows on models you installed yourself). Point this at a running
# ComfyUI server, e.g. http://127.0.0.1:8188
COMFYUI_URL=

# --- Backend data directory (optional override) ---
# Defaults to noobzy-studio/backend/data/ when unset.
NOOBZY_DATA_DIR=
