{
  "name": "noobzy-ai-studio-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "NOOBZY AI STUDIO -- Electron + Vite + React + TypeScript desktop shell for the local-first video editor.",
  "main": "electron-dist/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "build:electron": "tsc -p electron/tsconfig.json",
    "electron": "npm run build:electron && electron electron-dist/main.js"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.15",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "electron": "31.3.1",
    "typescript": "5.5.4",
    "vite": "5.4.1"
  }
}
